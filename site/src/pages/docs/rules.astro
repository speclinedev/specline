---
import Docs from "../../layouts/Docs.astro";
import Experimental from "../../components/Experimental.astro";

// Canon 3.1: severity is the layer, part is which of the canon's parts the rule
// belongs to. error = INTEGRITY (facts false regardless of taste) and blocks the
// gate; warning = ADVISORY (any judgment about whether a spec is good) and never
// blocks. Mirrors cli/src/engine/rules.ts REGISTRY exactly — `specline rules` is
// the authoritative machine-readable copy; this table is cross-checked against it
// id-for-id.
const part1 = [
  ["STRUCT-MISSING-SPEC", "error", "spec", "a specs/ folder has no spec.md — the constitutive file; the folder is not a spec without it."],
  ["FRONTMATTER-UNPARSEABLE", "error", "spec", "spec.md frontmatter is missing or doesn't parse."],
  ["FRONTMATTER-SLUG-MISMATCH", "error", "spec", "frontmatter slug doesn't match the directory."],
  ["ENUM-INVALID", "error", "spec", "a known enum (type, status, or — when unattended — build/blast_radius/size/target_model) has an invalid value."],
  ["UNKNOWN-FRONTMATTER-KEY", "warning", "spec", "an unrecognized frontmatter key — preserved, not failed (likely a newer canon)."],
  ["UNKNOWN-SECTION", "warning", "spec", "an unrecognized body section — preserved, not failed."],
  ["GOAL-MISSING", "warning", "spec", "a spec has no `## Goal` — one falsifiable line, the highest hydration value per character in the format."],
  ["PARENT-HAS-MECHANICS", "warning", "spec", "a type: parent carries Behavior or Acceptance — a parent is a map, not a plan."],
  ["PARENT-NO-SCOPES", "warning", "spec", "a type: parent lists no child scopes (nothing declares part_of: it) — a misfiled scope."],
];
const part2 = [
  ["SLUG-DUPLICATE", "error", "repo", "an active spec's slug collides with knowledge/ or archive/; the graduated knowledge + archive pair is legal."],
  ["RELATION-DANGLING", "error", "repo", "a relations.md edge points to a slug that exists nowhere in specs/, knowledge/, or archive/."],
  ["RELATION-UNPARSEABLE", "error", "repo", "relations.md in a spec or knowledge folder has invalid YAML or field shapes."],
  ["LINK-DANGLING", "error", "repo", "a relative link under docs/ doesn't resolve."],
  ["KNOWLEDGE-HAS-STATUS", "error", "repo", "knowledge/ contains a lifecycle artifact (status.md, open-questions.md)."],
  ["ARCHIVE-EDITED", "error", "repo", "an archived spec is modified (adding one is graduation, allowed) — the audit trail is immutable."],
  ["STRUCT-MISSING-RELATIONS", "warning", "spec", "a specs/ folder has no relations.md — an auxiliary file."],
  ["RELATION-CROSS-REPO", "warning", "repo", "a repo:slug edge — validated weakly, warn only."],
  ["RELATION-KILLED", "warning", "repo", "an edge points to a killed slug — warn only."],
  ["OPEN-QUESTION-INCOMPLETE", "warning", "spec", "a building spec's open question is missing a decider or default."],
  ["OPEN-QUESTION-OVERDUE", "warning", "spec", "an active spec has an open question past its deadline."],
  ["CANON-PIN-MISMATCH", "warning", "repo", "the repo's pinned canon (specline.yml, compared at MAJOR.MINOR) differs from the tool's served canon."],
];
const part3 = [
  ["UNATTENDED-INCOMPLETE", "warning", "spec", "build: unattended lacks blast_radius, loop_budget, status.md, or (once active) stale_after."],
  ["STATUS-SCHEMA", "warning", "spec", "status.md is missing or duplicates a required section."],
  ["CORRECTIONS-MALFORMED", "warning", "spec", "a status.md ## Corrections entry doesn't carry the `<what> — <altitude> — <who caught it>` shape."],
  ["LOOP-BUDGET-INVALID", "warning", "spec", "loop_budget is present but not a positive integer (the autonomy grant)."],
  ["JUDGEABLE-NO-SECTION", "warning", "spec", "a judgeable acceptance item names no spec section to judge against — not falsifiable."],
  ["CHECK-RUN-MALFORMED", "warning", "spec", "an acceptance item carries `— run:` but not a single backtick-fenced command. Absence of the suffix never fires."],
  ["SCOPE-EXCEEDS-SIZE", "warning", "spec", "size: small but measured size is over suggest_slicing_past — slice it, or declare size: large."],
  ["ACCEPTANCE-UNPARTITIONED", "warning", "spec", "an unattended spec has no `### agent-loopable` acceptance partition — the build loop has no labelled exit condition."],
  ["ARCHIVE-NO-ACCEPTANCE", "warning", "repo", "a shipped, archived spec carries no linked acceptance_results — graduation may have skipped its run."],
  ["STALE-QUARANTINE", "warning", "spec", "a building/blocked spec is past stale_after — flagged for a human."],
  ["DECIDER-OVER-BUDGET", "warning", "repo", "a decider is over the focus_limit for building or active specs."],
  ["COUPLING-CEILING", "warning", "spec", "spec + transitively forced loads exceeds coupling_ceiling% of context_window — too entangled."],
];
const totalRules = part1.length + part2.length + part3.length;
---
<Docs title="Rule catalog — Specline">
  <div class="doc-kicker">Specline · Rules</div>
  <h1>Rule catalog</h1>
  <p class="doc-lead">
    Every check Specline can emit, in one place — {totalRules} rules. The engine and
    <code>specline rules</code> read from the same registry, so a finding can never carry a
    <code>rule_id</code> the catalog lacks — and the catalog can never drift from what actually
    fires.
  </p>
  <p>
    <strong>Severity is the line.</strong> <code>error</code> means
    <strong>integrity</strong> — a fact that's broken regardless of any opinion about
    good specs; it fails the gate. <code>warning</code> means <strong>advisory</strong> —
    a judgment about whether a spec is <em>good</em> (completeness, sizing, mechanics,
    build-readiness); it's surfaced for the decider and <em>never</em> blocks. Specline runs in
    <strong>one mode</strong>: it reports every finding and exits nonzero when any of them is an
    error. <strong>Scope</strong> — <code>repo</code> findings consider the whole tree;
    <code>spec</code> integrity errors quarantine to <code>--changed</code>.
    Parts 1 and 2 always run. Part 3 runs, and is listed by <code>specline rules</code>, only
    when <code>specline.yml</code> sets <code>unattended: true</code>.
  </p>

  <h2>Part 1 — the spec ({part1.length})</h2>
  <div class="tbl-wrap">
    <table class="book-table">
      <thead><tr><th>rule_id</th><th>severity</th><th>scope</th><th>fires when</th></tr></thead>
      <tbody>
        {part1.map((r) => (
          <tr><td><code>{r[0]}</code></td><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Part 2 — the record ({part2.length})</h2>
  <div class="tbl-wrap">
    <table class="book-table">
      <thead><tr><th>rule_id</th><th>severity</th><th>scope</th><th>fires when</th></tr></thead>
      <tbody>
        {part2.map((r) => (
          <tr><td><code>{r[0]}</code></td><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Part 3 — unattended builds ({part3.length})</h2>
  <Experimental />
  <div class="tbl-wrap">
    <table class="book-table">
      <thead><tr><th>rule_id</th><th>severity</th><th>scope</th><th>fires when</th></tr></thead>
      <tbody>
        {part3.map((r) => (
          <tr><td><code>{r[0]}</code></td><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="doc-note">This table mirrors <code>specline rules --format json</code> — that command, not this page, is the authoritative machine-readable catalog. With <code>unattended</code> off, Part 3 is neither listed nor checked. A few canon checks that need git history (<code>specline diff</code>) or aren't built yet (<code>relations-index --fix</code>) are marked planned in the canon.</p>
</Docs>

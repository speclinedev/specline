---
import Docs from "../../../layouts/Docs.astro";
import Experimental from "../../../components/Experimental.astro";

const coreFields = [
  { field: "slug", values: "kebab-case", when: "Always. The spec's identity — matches the folder name; unique to one feature across specs/, knowledge/, and archive/. Graduation preserves the same slug in its knowledge + archive pair. Frozen once the spec lands on the merge target: renaming a referenced spec dangles its inbound edges. Re-slugging before it lands is legal — nothing points at it yet." },
  { field: "type", values: "feature | bug | chore | parent", when: "Always. A bug is a spec with type: bug; a decomposition parent is type: parent." },
  { field: "decider", values: "a named human", when: "Always. The PO accountable for this spec." },
  { field: "created", values: "date", when: "Always. Spec authoring date; the lead-time clock starts here." },
];

const legacyFields = [
  { field: "status", values: "shipped | killed", when: "Only in archive/ — location can't tell the two apart there. Dropped everywhere else: where a spec lives (drafts/ → specs/ → knowledge/ + archive/) is its state. A status: line written against an earlier canon (draft, ratified, building, blocked) is recognised silently." },
];

const envelopeFields = [
  { field: "build", values: "attended | unattended", when: "Optional — write it whenever the posture is known. Absent means attended: the builder can reach the decider. unattended is a promise that a fresh-context builder who cannot ask has everything it needs; it is what puts the envelope fields below in scope, and it changes no rule's severity." },
  { field: "blast_radius", values: "low | medium | high", when: "Legal on any spec; checked only when unattended. Declared risk surface; drives reviewer depth, implementer effort, and model tier." },
  { field: "size", values: "small | large", when: "Legal on any spec; checked only when unattended. Declared build size (default small). small = one slice; large = an atomic batch. The build axis — distinct from appetite (the review axis)." },
  { field: "target_model", values: "light | standard | frontier", when: "Optional; checked only when unattended. Pins a capability tier; if absent, derived from blast_radius and the coupling proxy." },
  { field: "stale_after", values: "date", when: "Checked only when unattended. Set on entering building or blocked — the staleness / abandonment trigger." },
  { field: "loop_budget", values: "positive integer", when: "Optional; checked only when unattended. The PO's autonomy grant — the cap on autonomous build cycles with no green-checkpoint advance." },
  { field: "acceptance_results", values: "a link", when: "On archived specs only; checked only when unattended — the structural proxy that graduation ran the acceptance checks." },
];
---
<Docs title="Reference — spec frontmatter">
  <div class="doc-kicker">Reference · Frontmatter</div>
  <h1>Spec frontmatter</h1>
  <p class="doc-lead">
    Frontmatter is <strong>identity — nothing else</strong>: four keys, always present.
    There is no <code>status</code> field to keep in step with the folder — <strong>where a
    spec lives is its state</strong> (see <a href="/docs/reference/lifecycle">lifecycle</a>).
    The graph lives only in <code>relations.md</code>. An agent triages any spec from its path
    and its first ten lines.
  </p>
  <div class="tbl-wrap">
    <table class="book-table">
      <thead><tr><th>Field</th><th>Values</th><th>When</th></tr></thead>
      <tbody>
        {coreFields.map((f) => (
          <tr><td><code>{f.field}</code></td><td>{f.values}</td><td>{f.when}</td></tr>
        ))}
        {legacyFields.map((f) => (
          <tr><td><code>{f.field}</code></td><td>{f.values}</td><td>{f.when}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>The unattended envelope</h2>
  <Experimental />
  <p>Legal on any spec, but what <code>build: unattended</code> promises — a builder that can't ask needs the routing, the leash, and the clock on the page. An attended spec may carry them when they're useful, but Specline only checks their completeness once the spec declares <code>build: unattended</code>.</p>
  <div class="tbl-wrap">
    <table class="book-table">
      <thead><tr><th>Field</th><th>Values</th><th>When</th></tr></thead>
      <tbody>
        {envelopeFields.map((f) => (
          <tr><td><code>{f.field}</code></td><td>{f.values}</td><td>{f.when}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
  <div class="callout"><span class="ci">▸</span><p><strong>These are per-spec, set at the decider's go.</strong> <code>loop_budget</code> lives <em>here</em>, in the spec's frontmatter — it is the PO's autonomy grant for <em>this</em> build, not a repo-wide setting in <code>specline.yml</code>. The build escalates back to a human gate at the first of two triggers: <code>loop_budget</code> exhausted (no progress) or <code>stale_after</code> reached (too much time).</p></div>
  <div class="callout"><span class="ci">▸</span><p>Up: <a href="/handbook/building">handbook — building</a>. The law: <a href="/spec.md">the canon, "Frontmatter"</a>.</p></div>
</Docs>

{
  "name": "@specline/cli",
  "version": "0.1.0",
  "description": "Deterministic structural validator for Specline repos.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "specline": "./src/cli/index.ts"
  },
  "scripts": {
    "specline": "node src/cli/index.ts",
    "test": "node --test test/*.test.ts",
    "sync-canon": "node scripts/sync-canon.mjs",
    "sync-canon:check": "node scripts/sync-canon.mjs --check",
    "build": "npm run sync-canon && bun build src/cli/index.ts --compile --outfile dist/specline",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2"
  }
}
